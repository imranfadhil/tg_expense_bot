# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here

# Secret Passphrase / PIN required to unlock the bot (leave blank to allow public access)
BOT_PASSPHRASE=change_me_secret_pin

# PostgreSQL Configuration (used by both Docker Compose and the Bot)
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=expense_secret_password
POSTGRES_DB=family_expenses
POSTGRES_HOST=db

# Optional: Direct SQLAlchemy Async URL override (if omitted, built from POSTGRES_* vars above)
# For running the bot locally on host while Postgres runs in Docker, set POSTGRES_HOST=localhost
# DATABASE_URL=postgresql+asyncpg://expense_user:expense_secret_password@localhost:5432/family_expenses

# Default currency symbol for new households
DEFAULT_CURRENCY=RM

# Timezone for monthly/daily boundaries (IANA format)
TIMEZONE=Asia/Kuala_Lumpur

# Telegram Mini App Live Dashboard (FastAPI)
WEBAPP_ENABLED=true
WEBAPP_PORT=8090
# Optional custom HTTPS URL (e.g. https://expenses.yourdomain.com).
# If left blank under Docker Compose, the bot automatically uses the built-in Cloudflare HTTPS Quick Tunnel!
WEBAPP_URL=


